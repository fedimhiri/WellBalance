{% extends 'frontend/base_frontend.html.twig' %}

{% block title %}Détails plan{% endblock %}

{% block body %}

{% set totalCalories = 0 %}
{% for r in plan.repas %}
  {% set totalCalories = totalCalories + (r.calories ?? 0) %}
{% endfor %}

{% set nbRepas = plan.repas|length %}
{% set avgCalories = nbRepas > 0 ? (totalCalories / nbRepas) : 0 %}
{% set actif = plan.dateFin >= date() %}

<div class="container py-4">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <h2 class="mb-1">{{ plan.objectif }}</h2>
      <div class="text-muted">
        {{ plan.dateDebut|date('d/m/Y') }} → {{ plan.dateFin|date('d/m/Y') }}
        • 
        <strong class="{{ actif ? 'text-success' : 'text-danger' }}">
          {{ actif ? 'Actif' : 'Terminé' }}
        </strong>
      </div>

      {% if plan.nutritionniste %}
        <div class="text-muted small">
          Nutritionniste : <strong>{{ plan.nutritionniste.nom }}</strong>
        </div>
      {% endif %}
    </div>

    <!-- BOUTONS -->
    <div class="d-flex gap-2 flex-wrap">

      <!-- ✅ BOUTON CHAT IA -->
      <a class="btn btn-primary"
         href="{{ path('nutrition_chat_page') }}">
        <i class="bx bx-chat me-2"></i>Chat Nutrition IA
      </a>

      <a class="btn btn-outline-danger"
         href="{{ path('front_plan_nutrition_pdf', {id: plan.id}) }}">
        <i class="bx bxs-file-pdf me-2"></i>PDF
      </a>

      {% if is_granted('ROLE_USER') %}
        <a class="btn btn-outline-primary"
           href="{{ path('front_suivi_index', {id: plan.id}) }}">
           Suivi & Alertes
        </a>
      {% endif %}

      <a class="btn btn-outline-secondary"
         href="{{ path('front_plan_nutrition_index') }}">
        Retour
      </a>

    </div>
  </div>

  <!-- ALERTES ACTIVES -->
  {% if alertes is defined and alertes|length > 0 %}
    <div class="alert alert-warning mb-4">
      <h6 class="mb-2">⚠ Alertes actives :</h6>
      <ul class="mb-0">
        {% for a in alertes %}
          <li>
            <strong>{{ a.severity }}</strong> —
            {{ a.message }}
            <small class="text-muted">({{ a.createdAt|date('d/m/Y') }})</small>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  <!-- STATS -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <div class="text-muted small">Nombre de repas</div>
          <div class="fs-4 fw-bold">{{ nbRepas }}</div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <div class="text-muted small">Total calories</div>
          <div class="fs-4 fw-bold">{{ totalCalories }}</div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <div class="text-muted small">Moyenne / repas</div>
          <div class="fs-4 fw-bold">{{ avgCalories|number_format(0) }}</div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <div class="text-muted small">Jours restants</div>
          <div class="fs-4 fw-bold">
            {{ actif ? plan.dateFin.diff(date()).days : 0 }}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- REPAS -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Repas recommandés</h4>

    {% if is_granted('ROLE_NUTRITIONNISTE') or is_granted('ROLE_ADMIN') %}
      <a class="btn btn-success btn-sm"
         href="{{ path('admin_repas_new', { plan_id: plan.id }) }}">
        + Ajouter repas
      </a>
    {% endif %}
  </div>

  {% if plan.repas|length == 0 %}
    <div class="alert alert-info">
      Aucun repas recommandé pour ce plan.
    </div>
  {% else %}
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Calories</th>
            <th>Description</th>
            {% if is_granted('ROLE_NUTRITIONNISTE') or is_granted('ROLE_ADMIN') %}
              <th>Actions</th>
            {% endif %}
          </tr>
        </thead>
        <tbody>
          {% for r in plan.repas %}
            <tr>
              <td>{{ r.dateRepas|date('d/m/Y H:i') }}</td>
              <td>{{ r.typeRepas }}</td>
              <td>{{ r.calories }}</td>
              <td>{{ r.description }}</td>

              {% if is_granted('ROLE_NUTRITIONNISTE') or is_granted('ROLE_ADMIN') %}
                <td>
                  <a class="btn btn-sm btn-primary"
                     href="{{ path('admin_repas_edit', {id: r.id}) }}">
                    Modifier
                  </a>
                </td>
              {% endif %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

</div>

{% endblock %}