{% extends 'backend/baseend.html.twig' %}

{% block title %}Repas{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Repas</h4>
        <nav class="d-flex">
            <h6 class="fw-normal text-muted mb-0">Nutrition / Repas</h6>
        </nav>
    </div>
    <a href="{{ path('admin_repas_new') }}" class="btn btn-primary">
        <i class="bx bx-plus me-2"></i>Nouveau Repas
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="alert alert-info mb-0">
            <i class="bx bx-info-circle me-2"></i>
            Calories aujourd'hui :
            <strong>{{ today_calories|default(0) }}</strong> kcal
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Calories</th>
                        <th>Macros</th>
                        <th>Date</th>
                        <th>Plan</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for repa in repas %}
                        <tr>
                            <td class="fw-medium">#{{ repa.id }}</td>

                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <span class="badge bg-primary">{{ repa.typeRepas }}</span>

                                    {# ✅ Badge API si barcode existe #}
                                    {% if repa.barcode %}
                                        <span class="badge bg-info">
                                            <i class="bx bx-cloud-download me-1"></i>API
                                        </span>
                                    {% endif %}
                                </div>
                            </td>

                            <td>
                                {% set desc = repa.description|default('') %}
                                {% if desc|length > 60 %}
                                    {{ desc|slice(0, 60) }}…
                                {% else %}
                                    {{ desc != '' ? desc : '-' }}
                                {% endif %}
                            </td>

                            <td>
                                {% if repa.calories is not null %}
                                    <span class="badge bg-warning text-dark">{{ repa.calories }} kcal</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>

                            {# ✅ Macros #}
                            <td>
                                <div class="small">
                                    <span class="me-2">
                                        <span class="text-muted">P:</span>
                                        <strong>{{ repa.proteines is not null ? repa.proteines ~ 'g' : '-' }}</strong>
                                    </span>
                                    <span class="me-2">
                                        <span class="text-muted">G:</span>
                                        <strong>{{ repa.glucides is not null ? repa.glucides ~ 'g' : '-' }}</strong>
                                    </span>
                                    <span>
                                        <span class="text-muted">L:</span>
                                        <strong>{{ repa.lipides is not null ? repa.lipides ~ 'g' : '-' }}</strong>
                                    </span>
                                </div>

                                {# Portion #}
                                {% if repa.portionSize %}
                                    <div class="text-muted small">Portion: {{ repa.portionSize }}</div>
                                {% endif %}
                            </td>

                            <td>{{ repa.dateRepas ? repa.dateRepas|date('d/m/Y H:i') : '-' }}</td>

                            <td>
                                {% if repa.planNutrition %}
                                    <a href="{{ path('admin_plan_nutrition_show', {'id': repa.planNutrition.id}) }}">
                                        {{ repa.planNutrition.objectif }}
                                    </a>
                                {% else %}
                                    -
                                {% endif %}
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="{{ path('admin_repas_show', {'id': repa.id}) }}"
                                       class="btn btn-sm btn-outline-primary" title="Voir">
                                        <i class="bx bx-show"></i>
                                    </a>

                                    <a href="{{ path('admin_repas_edit', {'id': repa.id}) }}"
                                       class="btn btn-sm btn-outline-warning" title="Modifier">
                                        <i class="bx bx-edit"></i>
                                    </a>

                                    <form method="post" action="{{ path('admin_repas_delete', {'id': repa.id}) }}"
                                          onsubmit="return confirm('Supprimer ce repas ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ repa.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <div class="text-muted">
                                    <i class="bx bx-food-menu fs-1"></i>
                                    <p class="mt-2 mb-2">Aucun repas trouvé</p>
                                    <a href="{{ path('admin_repas_new') }}" class="btn btn-primary mt-2">
                                        Ajouter un repas
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
