{% extends 'backend/baseend.html.twig' %}

{% block title %}Suivis du plan{% endblock %}

{% block body %}
<div class="container-fluid mt-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h4 class="fw-bold mb-0">Suivis — Plan #{{ plan.id }}</h4>
      <div class="text-muted">Patient : {{ plan.user.email }}</div>
    </div>

    <a class="btn btn-outline-secondary"
       href="{{ path('admin_plan_nutrition_show', {id: plan.id}) }}">
      Retour
    </a>
  </div>

  {% if suivis|length == 0 %}
    <div class="alert alert-info">Aucun suivi enregistré pour ce plan.</div>
  {% else %}
    <div class="card">
      <div class="card-body">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Date</th>
              <th>Poids</th>
              <th>Respect %</th>
              <th>Humeur</th>
              <th>Commentaire patient</th>
              <th>Commentaire nutritionniste</th>
            </tr>
          </thead>
          <tbody>
            {% for s in suivis %}
              <tr>
                <td>{{ s.dateSuivi|date('d/m/Y H:i') }}</td>
                <td>{{ s.poids ?? '-' }}</td>
                <td>{{ s.respectPourcentage }}</td>
                <td>{{ s.humeur ?? '-' }}</td>
                <td>{{ s.commentairePatient ?? '-' }}</td>
                <td>{{ s.commentaireNutritionniste ?? '-' }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}

</div>
{% endblock %}
