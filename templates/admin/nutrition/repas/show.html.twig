{% extends 'backend/baseend.html.twig' %}

{% block title %}Détails Repas{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-0">Repas #{{ repa.id }}</h4>
    <nav class="d-flex">
      <h6 class="fw-normal text-muted mb-0">
        <a href="{{ path('admin_repas_index') }}" class="text-muted">Nutrition / Repas</a>
        / #{{ repa.id }}
      </h6>
    </nav>
  </div>

  <div class="d-flex gap-2">
    <a href="{{ path('admin_repas_edit', {'id': repa.id}) }}" class="btn btn-warning">
      <i class="bx bx-edit me-2"></i>Modifier
    </a>
    <a href="{{ path('admin_repas_index') }}" class="btn btn-outline-secondary">
      <i class="bx bx-arrow-back me-2"></i>Retour
    </a>
  </div>
</div>

<div class="row">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-body">

        {# ✅ Badges API #}
        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
          {% if repa.barcode %}
            <span class="badge bg-info">
              <i class="bx bx-cloud-download me-1"></i>Données API
            </span>
          {% endif %}
          {% if repa.portionSize %}
            <span class="badge bg-secondary">
              Portion: {{ repa.portionSize }}
            </span>
          {% endif %}
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted small">Type</label>
            <h5 class="fw-bold mb-0">{{ repa.typeRepas }}</h5>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label text-muted small">Calories</label>
            <h5 class="fw-bold mb-0">
              {% if repa.calories is not null %}
                {{ repa.calories }} kcal
              {% else %}
                <span class="text-muted">-</span>
              {% endif %}
            </h5>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label text-muted small">Date</label>
            <p class="fw-medium mb-0">{{ repa.dateRepas ? repa.dateRepas|date('d/m/Y H:i') : '-' }}</p>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label text-muted small">Plan nutrition</label>
            <p class="fw-medium mb-0">
              {% if repa.planNutrition %}
                <a href="{{ path('admin_plan_nutrition_show', {'id': repa.planNutrition.id}) }}">
                  {{ repa.planNutrition.objectif }}
                </a>
              {% else %}
                <span class="text-muted">-</span>
              {% endif %}
            </p>
          </div>

          {# ✅ Code-barres #}
          <div class="col-md-6 mb-3">
            <label class="form-label text-muted small">Code-barres</label>
            <p class="fw-medium mb-0">
              {% if repa.barcode %}
                <code>{{ repa.barcode }}</code>
              {% else %}
                <span class="text-muted">-</span>
              {% endif %}
            </p>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label text-muted small">Portion</label>
            <p class="fw-medium mb-0">
              {% if repa.portionSize%}
                {{ repa.portionSize }}
              {% else %}
                <span class="text-muted">-</span>
              {% endif %}
            </p>
          </div>

          <div class="col-12 mb-3">
            <label class="form-label text-muted small">Description</label>
            <p class="fw-medium mb-0">{{ repa.description }}</p>
          </div>
        </div>

        <div class="d-flex gap-2 mt-3">
          <form method="post"
                action="{{ path('admin_repas_delete', {'id': repa.id}) }}"
                onsubmit="return confirm('Supprimer ce repas ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ repa.id) }}">
            <button class="btn btn-outline-danger">
              <i class="bx bx-trash me-2"></i>Supprimer
            </button>
          </form>
        </div>

      </div>
    </div>
  </div>

  {# ✅ Sidebar macros #}
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header">
        <h6 class="mb-0"><i class="bx bx-food-menu me-2"></i>Macros</h6>
      </div>
      <div class="card-body">
        <div class="row g-2">
          <div class="col-4">
            <div class="border rounded p-2 text-center">
              <div class="text-muted small">Protéines</div>
              <div class="fw-bold">
                {% if repa.proteines is not null %}
                  {{ repa.proteines }} g
                {% else %}
                  -
                {% endif %}
              </div>
            </div>
          </div>

          <div class="col-4">
            <div class="border rounded p-2 text-center">
              <div class="text-muted small">Glucides</div>
              <div class="fw-bold">
                {% if repa.glucides is not null %}
                  {{ repa.glucides }} g
                {% else %}
                  -
                {% endif %}
              </div>
            </div>
          </div>

          <div class="col-4">
            <div class="border rounded p-2 text-center">
              <div class="text-muted small">Lipides</div>
              <div class="fw-bold">
                {% if repa.lipides is not null %}
                  {{ repa.lipides }} g
                {% else %}
                  -
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        {% if repa.barcode %}
          <div class="alert alert-info mt-3 mb-0">
            <div class="fw-bold">Source</div>
            <div class="small text-muted">
              Valeurs récupérées via API OpenFoodFacts (souvent /100g).
            </div>
          </div>
        {% else %}
          <div class="alert alert-light mt-3 mb-0">
            <div class="small text-muted">
              Astuce : ajoute un code-barres dans “Modifier” puis clique “Remplir depuis API”.
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
