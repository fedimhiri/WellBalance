{% extends 'backend/baseend.html.twig' %}

{% block title %}Nouveau document{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="bx bx-plus-circle me-2"></i>Créer un document</h4>
        <a href="{{ path('admin_document_index') }}" class="btn btn-outline-secondary">
            <i class="bx bx-arrow-back me-1"></i> Retour
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-body">
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_row(form.titre) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_row(form.typeDocument) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_row(form.categorie) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_row(form.insuranceReference) }}
                </div>
                <div class="col-12 mb-3">
                    {{ form_row(form.fichier) }}
                    <small class="text-muted">PDF uniquement, max 5 Mo</small>
                </div>
            </div>
            <button type="submit" class="btn btn-success"><i class="bx bx-save me-1"></i> Créer</button>
            <a href="{{ path('admin_document_index') }}" class="btn btn-outline-secondary">Annuler</a>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
