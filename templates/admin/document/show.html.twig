{% extends 'backend/baseend.html.twig' %}

{% block title %}{{ document.titre }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="bx bx-file me-2"></i>{{ document.titre }}</h4>
        <div>
            <a href="{{ path('admin_document_edit', {id: document.id}) }}" class="btn btn-primary">
                <i class="bx bx-edit me-1"></i> Modifier
            </a>
            <a href="{{ path('admin_document_download', {id: document.id}) }}" class="btn btn-secondary">
                <i class="bx bx-download me-1"></i> Télécharger
            </a>
            <a href="{{ path('admin_document_index') }}" class="btn btn-outline-secondary">Retour</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Titre</dt>
                <dd class="col-sm-9">{{ document.titre }}</dd>
                <dt class="col-sm-3">Catégorie</dt>
                <dd class="col-sm-9">{{ document.categorie ? document.categorie.nom : '—' }}</dd>
                <dt class="col-sm-3">Utilisateur</dt>
                <dd class="col-sm-9">{{ document.user ? document.user.displayName : '—' }}</dd>
                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9"><span class="badge bg-primary">{{ document.typeDocument }}</span></dd>
                <dt class="col-sm-3">Réf. assurance</dt>
                <dd class="col-sm-9">{{ document.insuranceReference ?? '—' }}</dd>
                <dt class="col-sm-3">Date d'upload</dt>
                <dd class="col-sm-9">{{ document.dateUpload|date('d/m/Y H:i') }}</dd>
                <dt class="col-sm-3">Résumé IA</dt>
                <dd class="col-sm-9">{{ document.resumeAi ?? '—' }}</dd>
                <dt class="col-sm-3">Mots-clés</dt>
                <dd class="col-sm-9">
                    {% if document.motsCles %}
                        {% for mot in document.motsCles %}
                            <span class="badge bg-secondary me-1">{{ mot }}</span>
                        {% endfor %}
                    {% else %}
                        —
                    {% endif %}
                </dd>
            </dl>
        </div>
    </div>
</div>
{% endblock %}
