{% extends 'backend/baseend.html.twig' %}

{% block title %}Nouvelle catégorie{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="bx bx-plus-circle me-2"></i>Créer une catégorie</h4>
        <a href="{{ path('admin_categorie_index') }}" class="btn btn-outline-secondary">
            <i class="bx bx-arrow-back me-1"></i> Retour
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {{ form_row(form.description) }}
            <button type="submit" class="btn btn-success"><i class="bx bx-save me-1"></i> Créer</button>
            <a href="{{ path('admin_categorie_index') }}" class="btn btn-outline-secondary">Annuler</a>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
