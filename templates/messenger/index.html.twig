{% extends 'messenger/_base_admin.html.twig' %}

{% block title %}Messagerie Admin{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Summaries of Conversations</h2>
        <a href="{{ path('Messenger_dashboard') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Tableau de bord Messagerie
        </a>
    </div>

    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-body">
            {# Recherche #}
            <form method="get" class="mb-4">
                <div class="row g-2 align-items-center">
                    <div class="col-md-6">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control" placeholder="Rechercher..." value="{{ search }}" data-conversation-search>
                            <button type="submit" class="btn btn-secondary">Rechercher</button>
                            {% if search %}
                                <a href="{{ path('admin_messenger_index', {sortBy: sortBy, sortOrder: sortOrder}) }}" class="btn btn-outline-secondary">Effacer</a>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="sortBy" class="form-select" data-conversation-sortby>
                            <option value="updatedAt" {{ sortBy == 'updatedAt' ? 'selected' : '' }}>Plus récents</option>
                            <option value="createdAt" {{ sortBy == 'createdAt' ? 'selected' : '' }}>Date de création</option>
                            <option value="type" {{ sortBy == 'type' ? 'selected' : '' }}>Type</option>
                            <option value="user" {{ sortBy == 'user' ? 'selected' : '' }}>Patient</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="sortOrder" class="form-select" data-conversation-sortorder>
                            <option value="DESC" {{ sortOrder == 'DESC' ? 'selected' : '' }}>Décroissant</option>
                            <option value="ASC" {{ sortOrder == 'ASC' ? 'selected' : '' }}>Croissant</option>
                        </select>
                    </div>
                </div>
            </form>

            {# Liste #}
            {% if conversations is not empty %}
                <table class="table table-striped" id="conversations-table"
                       data-base-url="{{ path('admin_messenger_index')|replace({'/listes_conversations': ''}) }}"
                       data-list-url="{{ path('admin_messenger_index') }}"
                       data-viewer-role="admin"
                       data-search="{{ search }}"
                       data-sort-by="{{ sortBy }}"
                       data-sort-order="{{ sortOrder }}">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Dernier message</th>
                            <th>Statut</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for conversation in conversations %}
                            {% set lastMessage = conversation.messages|last %}
                            {% set unread = conversation.getUnreadCountFor(app.user) %}
                            <tr class="conversation-row" data-conversation-id="{{ conversation.id }}">
                                <td>
                                    {{ conversation.user.username }}
                                    <br>
                                    <small class="text-muted">#{{ conversation.user.id }}</small>
                                </td>
                                <td class="last-message-cell">
                                    {% if lastMessage %}
                                        {{ lastMessage.content|slice(0, 50) }}...
                                    {% else %}
                                        <em>Aucun message</em>
                                    {% endif %}
                                </td>
                                <td class="status-cell">
                                    {% if unread > 0 %}
                                        <span class="badge bg-danger status-badge">{{ unread }} non lu(s)</span>
                                    {% else %}
                                        <span class="badge bg-success status-badge">À jour</span>
                                    {% endif %}
                                </td>
                                <td class="date-cell">
                                    {{ conversation.updatedAt|date('d/m/Y H:i') }}
                                </td>
                                <td>
                                    <a href="{{ path('admin_messenger_show', {id: conversation.id}) }}" class="btn btn-sm btn-info text-white">Voir</a>
                                    <a href="{{ path('admin_messenger_conversation_delete', {id: conversation.id}) }}" 
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Supprimer ?')">Supprimer</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <p class="text-center d-none" id="conversations-empty">Aucune conversation trouvée.</p>
            {% else %}
                <table class="table table-striped d-none" id="conversations-table"
                       data-base-url="{{ path('admin_messenger_index')|replace({'/listes_conversations': ''}) }}"
                       data-list-url="{{ path('admin_messenger_index') }}"
                       data-viewer-role="admin"
                       data-search="{{ search }}"
                       data-sort-by="{{ sortBy }}"
                       data-sort-order="{{ sortOrder }}">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Dernier message</th>
                            <th>Statut</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                <p class="text-center" id="conversations-empty">Aucune conversation trouvée.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
