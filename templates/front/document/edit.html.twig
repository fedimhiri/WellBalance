{% extends 'frontend/base_frontend.html.twig' %}

{% block title %}Modifier le document - WellBalance{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Modifier le document</h2>
        <a href="{{ path('front_documents') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
    </div>

    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        La modification des documents n'est pas disponible pour le moment. 
        Vous pouvez supprimer ce document et en créer un nouveau.
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <table class="table mb-0">
                <tbody>
                    <tr>
                        <th style="width: 150px;">Titre</th>
                        <td>{{ document.titre|default('-') }}</td>
                    </tr>
                    <tr>
                        <th>Type</th>
                        <td>{{ document.typeDocument|default('-') }}</td>
                    </tr>
                    <tr>
                        <th>Date d'upload</th>
                        <td>
                            {% if document.dateUpload is defined and document.dateUpload %}
                                {{ document.dateUpload|date('d/m/Y H:i') }}
                            {% else %}
                                -
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="{{ path('front_document_show', {id: document.id}) }}">
            <i class="bi bi-eye me-1"></i> Voir le document
        </a>
    </div>
</div>
{% endblock %}
