{# templates/frontend/login.html.twig #}
{% extends 'frontend/base_frontend.html.twig' %}
{% block title %}Connexion{% endblock %}

{% block body %}
<div class="auth-creative-wrapper py-5">
    <div class="auth-creative-inner">
        <div class="creative-card-wrapper">
            <div class="card my-4 overflow-hidden" style="z-index: 1">
                <div class="row flex-1 g-0">

                    <!-- FORMULAIRE -->
                    <div class="col-lg-6 h-100 my-auto order-1 order-lg-0">
                        <div class="creative-card-body card-body p-sm-5">

                            <h2 class="fs-20 fw-bolder mb-4 text-center">Connexion</h2>
                            <p class="fs-12 fw-medium text-muted text-center mb-4">
                                Accédez à votre espace patient en toute sécurité.
                            </p>

                            {% if error %}
                                <div class="alert alert-danger text-center">
                                    {{ error.messageKey|trans(error.messageData, 'security') }}
                                </div>
                            {% endif %}

                            <form method="post" class="mt-3">

                                <!-- EMAIL -->
                                <div class="mb-3">
                                    <input type="email"
                                           name="email"
                                           value="{{ last_username }}"
                                           class="form-control"
                                           placeholder="Adresse email"
                                           required autofocus>
                                </div>

                                <!-- PASSWORD -->
                                <div class="mb-3">
                                    <input type="password"
                                           name="password"
                                           class="form-control"
                                           placeholder="Mot de passe"
                                           required>
                                </div>

                                <!-- REMEMBER + FORGOT -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="form-check">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               id="remember_me"
                                               name="_remember_me">
                                        <label class="form-check-label" for="remember_me">
                                            Se souvenir de moi
                                        </label>
                                    </div>

                                    <a href="{{ path('frontend_forgot_password') }}">
    Mot de passe oublié ?
</a>

                                </div>

                                <!-- RECAPTCHA -->
                                <div class="mb-4 d-flex justify-content-center">
                                    <div class="g-recaptcha"
                                         data-sitekey="{{ app.request.server.get('RECAPTCHA_SITE_KEY') }}">
                                    </div>
                                </div>

                                <!-- CSRF -->
                                <input type="hidden"
                                       name="_csrf_token"
                                       value="{{ csrf_token('authenticate') }}">

                                <!-- BOUTON LOGIN -->
                                <div class="d-flex justify-content-center mt-3">
                                    <button type="submit"
                                            class="btn btn-primary px-5"
                                            style="min-width:220px;">
                                        Se connecter
                                    </button>
                                </div>

                            </form>

                            <!-- INSCRIPTION -->
                            <div class="mt-4 text-center text-muted">
                                <span>Pas encore de compte ?</span>
                                <a href="{{ path('app_register') }}" class="fw-bold ms-1">
                                    Créer un compte
                                </a>
                            </div>

                            <!-- GOOGLE LOGIN -->
                            <div class="mt-4 d-flex justify-content-center">
                                <a href="{{ path('connect_google') }}"
                                   class="btn btn-danger px-5"
                                   style="min-width:220px;">
                                    <i class="bi bi-google me-2"></i>
                                    Continuer avec Google
                                </a>
                            </div>

                        </div>
                    </div>

                    <!-- IMAGE CÔTÉ DROIT -->
                    <div class="col-lg-6 bg-primary order-0 order-lg-1">
                        <div class="h-100 d-flex align-items-center justify-content-center p-4">
                            <div class="text-center text-white">
                                <h3 class="fw-bold mb-3">Bienvenue</h3>
                                <p class="mb-4">
                                    Gérez vos rendez-vous médicaux, consultez vos résultats
                                    et accédez à votre dossier médical en toute sécurité.
                                </p>
                                <a href="{{ path('app_frontend_vue') }}"
                                   class="btn btn-light">
                                    <i class="bi bi-house me-2"></i>
                                    Retour à l'accueil
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endblock %}
