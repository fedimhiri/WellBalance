{% extends 'backend/baseend.html.twig' %}

{% block title %}Nouveau Document{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="bx bx-plus-circle me-2"></i>Nouveau Document Médical
        </h4>
        <a href="{{ path('app_document_index') }}" class="btn btn-outline-secondary">
            <i class="bx bx-arrow-back me-1"></i> Retour
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-body">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.titre) }}
                    {{ form_widget(form.titre) }}
                    {{ form_errors(form.titre) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.typeDocument) }}
                    {{ form_widget(form.typeDocument) }}
                    {{ form_errors(form.typeDocument) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.categorie) }}
                    {{ form_widget(form.categorie) }}
                    {{ form_errors(form.categorie) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.fichier) }}
                    {{ form_widget(form.fichier) }}
                    {{ form_errors(form.fichier) }}
                    <small class="text-muted">Fichier PDF uniquement, max 5 Mo</small>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-title mb-3">
                                <i class="bx bx-bell me-1"></i> Notifications
                            </h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        {{ form_widget(form.notifySms) }}
                                        {{ form_label(form.notifySms) }}
                                        {{ form_errors(form.notifySms) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        {{ form_widget(form.notifyEmail) }}
                                        {{ form_label(form.notifyEmail) }}
                                        {{ form_errors(form.notifyEmail) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-upload me-1"></i> Enregistrer et analyser
                </button>
                <a href="{{ path('app_document_index') }}" class="btn btn-outline-secondary ms-2">Annuler</a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
