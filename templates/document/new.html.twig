{% extends 'frontend/base_frontend.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Nouveau Document - WellBalance{% endblock %}

{% block body %}
    <section class="section py-5" style="background-color: #fff;">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 mb-0">
                    <i class="bi bi-plus-circle me-2"></i>Nouveau Document Médical
                </h1>
                <a href="{{ path('app_document_index') }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Retour
                </a>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <div class="card">
                <div class="card-body">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(form.titre) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.typeDocument) }}
                            {{ form_widget(form.typeDocument, { attr: { class: 'form-select' } }) }}
                            {{ form_errors(form.typeDocument) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.categorie) }}
                            {{ form_widget(form.categorie, { attr: { class: 'form-select' } }) }}
                            {{ form_errors(form.categorie) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.fichier) }}
                            {{ form_widget(form.fichier, { attr: { class: 'form-control', accept: '.pdf' } }) }}
                            {{ form_errors(form.fichier) }}
                            <small class="text-muted">Fichier PDF uniquement, max 5 Mo</small>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title mb-3">
                                        <i class="bi bi-bell me-2"></i> Notifications
                                    </h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                {{ form_widget(form.notifySms) }}
                                                {{ form_label(form.notifySms) }}
                                                {{ form_errors(form.notifySms) }}
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                {{ form_widget(form.notifyEmail) }}
                                                {{ form_label(form.notifyEmail) }}
                                                {{ form_errors(form.notifyEmail) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-upload me-1"></i> Enregistrer et analyser
                        </button>
                        <a href="{{ path('app_document_index') }}" class="btn btn-outline-secondary ms-2">Annuler</a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </section>

{% endblock %}
