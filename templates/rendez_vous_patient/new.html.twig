{% extends 'frontend/base_frontend.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Nouveau rendez-vous{% endblock %}

{% block body %}
    <section class="section py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 mb-0">Prendre un rendez-vous</h1>
                <a href="{{ path('app_frontend_vue') }}" class="btn btn-outline-secondary">Retour</a>
            </div>

            <div class="card">
                <div class="card-body">
                    {{ form_start(form, { attr: { class: 'row g-3', novalidate: 'novalidate' } }) }}
                        <div class="col-12">{{ form_errors(form) }}</div>
                        <div class="col-md-6">{{ form_row(form.titre) }}</div>
                        <div class="col-md-6">{{ form_row(form.typeRendezVous) }}</div>
                        <div class="col-12">{{ form_row(form.description) }}</div>
                        <div class="col-md-6">{{ form_row(form.dateRdv) }}</div>
                        <div class="col-md-6">{{ form_row(form.heureRdv) }}</div>
                        <div class="col-md-6">{{ form_row(form.medecin) }}</div>
                        <div class="col-12 d-flex gap-2">
                            <button class="btn btn-primary" type="submit">Valider</button>
                            <a href="{{ path('app_frontend_vue') }}" class="btn btn-outline-secondary">Annuler</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
