{% extends 'frontend/base_frontend.html.twig' %}

{% block title %}Mes rendez-vous{% endblock %}

{% block body %}
    <section class="section py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 mb-0">Mes rendez-vous</h1>
                <a href="{{ path('patient_rendez_vous_new') }}" class="btn btn-primary">Prendre un rendez-vous</a>
            </div>

            <div class="card">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Date</th>
                            <th>Heure</th>
                            <th>Type</th>
                            <th>Medecin</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for rdv in rendezVousList %}
                            <tr>
                                <td>{{ rdv.titre }}</td>
                                <td>{{ rdv.dateRdv|date('d/m/Y') }}</td>
                                <td>{{ rdv.heureRdv|date('H:i') }}</td>
                                <td>{{ rdv.typeRendezVous.nomType }}</td>
                                <td>{{ rdv.medecin ? rdv.medecin.displayName : '-' }}</td>
                                <td>{% include 'rendez_vous/_status_badge.html.twig' with { statut: rdv.statut } only %}</td>
                                <td>
                                    <a href="{{ path('patient_rendez_vous_show', {id: rdv.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                                    {% if rdv.statut == constant('App\\\\Entity\\\\RendezVous::STATUT_EN_ATTENTE') %}
                                        <a href="{{ path('patient_rendez_vous_edit', {id: rdv.id}) }}" class="btn btn-sm btn-outline-secondary">Editer</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7">Aucun rendez-vous.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
