{% extends 'frontend/base_frontend.html.twig' %}
{% block title %}Nouveau suivi{% endblock %}

{% block body %}
<div class="container py-4">
  <h3 class="mb-3">Ajouter un suivi</h3>

  {{ form_start(form) }}
    {{ form_row(form.dateSuivi) }}
    {{ form_row(form.poids) }}
    {{ form_row(form.respectPourcentage) }}
    {{ form_row(form.humeur) }}
    {{ form_row(form.commentairePatient) }}

    <button class="btn btn-primary">Enregistrer</button>
    <a class="btn btn-secondary" href="{{ path('front_suivi_index', {id: plan.id}) }}">Retour</a>
  {{ form_end(form) }}
</div>
{% endblock %}
