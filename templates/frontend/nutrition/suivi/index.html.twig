{% extends 'frontend/base_frontend.html.twig' %}
{% block title %}Mes suivis{% endblock %}

{% block body %}
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Suivis - Plan #{{ plan.id }}</h3>
    <a class="btn btn-success btn-sm" href="{{ path('front_suivi_new', {id: plan.id}) }}">+ Ajouter suivi</a>
  </div>

  {% if alertes|length > 0 %}
    <div class="alert alert-warning">
      <strong>Alertes :</strong>
      <ul class="mb-0">
        {% for a in alertes %}
          <li><strong>{{ a.severity }}</strong> — {{ a.message }} ({{ a.createdAt|date('d/m/Y') }})</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if suivis|length == 0 %}
    <div class="alert alert-info">Aucun suivi.</div>
  {% else %}
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Date</th>
          <th>Poids</th>
          <th>Respect %</th>
          <th>Humeur</th>
        </tr>
      </thead>
      <tbody>
        {% for s in suivis %}
          <tr>
            <td>{{ s.dateSuivi|date('d/m/Y H:i') }}</td>
            <td>{{ s.poids ?? '-' }}</td>
            <td>{{ s.respectPourcentage }}</td>
            <td>{{ s.humeur ?? '-' }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
</div>
{% endblock %}
