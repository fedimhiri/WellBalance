{% extends 'frontend/base_frontend.html.twig' %}

{% block title %}Détails plan{% endblock %}

{% block body %}

{% set totalCalories = 0 %}
{% for r in plan.repas %}
  {% set totalCalories = totalCalories + (r.calories ?? 0) %}
{% endfor %}

{% set nbRepas = plan.repas|length %}
{% set avgCalories = nbRepas > 0 ? (totalCalories / nbRepas) : 0 %}
{% set actif = plan.dateFin >= date() %}

<div class="container py-4">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <h2 class="mb-1">{{ plan.objectif }}</h2>
      <div class="text-muted">
        {{ plan.dateDebut|date('d/m/Y') }} → {{ plan.dateFin|date('d/m/Y') }}
        •
        <strong class="{{ actif ? 'text-success' : 'text-danger' }}">
          {{ actif ? 'Actif' : 'Terminé' }}
        </strong>
      </div>

      {% if plan.nutritionniste %}
        <div class="text-muted small">
          Nutritionniste : <strong>{{ plan.nutritionniste.username }}</strong>
        </div>
      {% endif %}
    </div>

    <!-- BOUTONS -->
    <div class="d-flex gap-2 flex-wrap">

      <a class="btn btn-primary" href="{{ path('nutrition_chat_page') }}">
        <i class="bi bi-chat-dots me-2"></i>Chat Nutrition IA
      </a>

      <a class="btn btn-outline-danger" href="{{ path('front_plan_nutrition_pdf', {id: plan.id}) }}">
        <i class="bi bi-file-earmark-pdf me-2"></i>PDF
      </a>

      {% if app.user %}
        <a class="btn btn-outline-warning" href="#alertes">
          <i class="bi bi-exclamation-triangle me-2"></i>Alertes
        </a>

        <a class="btn btn-outline-primary" href="#suivi">
          <i class="bi bi-graph-up me-2"></i>Suivi
        </a>

        <a class="btn btn-success" href="{{ path('front_suivi_new', {id: plan.id}) }}">
          <i class="bi bi-plus-circle me-2"></i>Ajouter suivi
        </a>

        <a class="btn btn-outline-secondary" href="{{ path('front_suivi_index', {id: plan.id}) }}">
          <i class="bi bi-list-check me-2"></i>Voir suivi & alertes
        </a>
      {% endif %}

      <a class="btn btn-outline-secondary" href="{{ path('front_plan_nutrition_index') }}">
        Retour
      </a>
    </div>
  </div>

  <!-- ALERTES -->
  <div id="alertes"></div>
  <div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <div class="fw-semibold">
        <i class="bi bi-exclamation-triangle me-2"></i>Alertes détectées
      </div>
      <span class="badge bg-danger">{{ alertes|length }}</span>
    </div>

    <div class="card-body">
      {% if alertes is empty %}
        <div class="text-muted">Aucune alerte active ✅</div>
      {% else %}
        <ul class="list-group">
          {% for a in alertes %}
            <li class="list-group-item d-flex justify-content-between align-items-start">
              <div class="me-3">
                <div class="fw-semibold">{{ a.type }}</div>
                <div class="small text-muted">{{ a.message }}</div>
                <div class="small text-muted">{{ a.createdAt|date('d/m/Y H:i') }}</div>
              </div>
              <span class="badge bg-warning text-dark">{{ a.severity }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>

  <!-- SUIVI -->
  <div id="suivi"></div>
  <div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <div class="fw-semibold">
        <i class="bi bi-graph-up me-2"></i>Suivi (aperçu)
      </div>
      <span class="badge bg-primary">{{ suivis|length }}</span>
    </div>

    <div class="card-body">
      {% if suivis is empty %}
        <div class="text-muted">Aucun suivi enregistré pour le moment.</div>
      {% else %}
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead>
              <tr>
                <th>Date</th>
                <th>Poids</th>
                <th>Respect %</th>
                <th>Humeur</th>
                <th>Commentaire patient</th>
              </tr>
            </thead>
            <tbody>
              {% for s in suivis %}
                <tr>
                  <td>{{ s.dateSuivi|date('d/m/Y') }}</td>
                  <td>{{ s.poids ?? '-' }}</td>
                  <td>{{ s.respectPourcentage }}%</td>
                  <td>{{ s.humeur ?? '-' }}</td>
                  <td class="text-muted">{{ s.commentairePatient ?? '-' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- STATS -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <div class="text-muted small">Nombre de repas</div>
          <div class="fs-4 fw-bold">{{ nbRepas }}</div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <div class="text-muted small">Total calories</div>
          <div class="fs-4 fw-bold">{{ totalCalories }}</div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <div class="text-muted small">Moyenne / repas</div>
          <div class="fs-4 fw-bold">{{ avgCalories|number_format(0) }}</div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <div class="text-muted small">Jours restants</div>
          <div class="fs-4 fw-bold">
            {{ actif ? plan.dateFin.diff(date()).days : 0 }}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- REPAS -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Repas recommandés</h4>

    {% if app.user %}
      <a class="btn btn-success btn-sm" href="{{ path('front_repas_new', {id: plan.id}) }}">
        + Ajouter repas
      </a>
    {% endif %}
  </div>

  {% if plan.repas|length == 0 %}
    <div class="alert alert-info">
      Aucun repas recommandé pour ce plan.
    </div>
  {% else %}
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Calories</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {% for r in plan.repas %}
            <tr>
              <td>{{ r.dateRepas|date('d/m/Y H:i') }}</td>
              <td>{{ r.typeRepas }}</td>
              <td>{{ r.calories }}</td>
              <td>{{ r.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

</div>

{% endblock %}