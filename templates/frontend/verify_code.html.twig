{% extends 'frontend/base_frontend.html.twig' %}

{% block title %}Vérification du code{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width:450px;">
        <div class="card-body">

            <h3 class="text-center mb-4">Vérification du code</h3>

            {% for message in app.flashes('danger') %}
                <div class="alert alert-danger text-center">
                    {{ message }}
                </div>
            {% endfor %}

            <form method="post">

                <div class="mb-3">
                    <input type="text"
                           name="code"
                           class="form-control text-center"
                           placeholder="Entrez le code reçu"
                           maxlength="6"
                           required>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">
                        Vérifier
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
{% endblock %}
