{% extends 'frontend/base_frontend.html.twig' %}

{% block body %}
<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">

                    <h3 class="text-center fw-bold mb-4">
                        <i class="bi bi-person-circle me-2 text-primary"></i>
                        Mon Profil
                    </h3>

                    {# Flash messages #}
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success text-center">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('danger') %}
                        <div class="alert alert-danger text-center">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {{ form_start(profileForm) }}

                    <!-- Email -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Adresse email</label>
                        {{ form_widget(profileForm.email, {
                            'attr': {'class': 'form-control bg-light'}
                        }) }}
                    </div>

                    <!-- Username -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Nom d'utilisateur</label>
                        {{ form_widget(profileForm.username, {
                            'attr': {'class': 'form-control'}
                        }) }}
                        <div class="text-danger small">
                            {{ form_errors(profileForm.username) }}
                        </div>
                    </div>

                    <!-- Telephone -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Téléphone</label>
                        {{ form_widget(profileForm.telephone, {
                            'attr': {'class': 'form-control'}
                        }) }}
                        <div class="text-danger small">
                            {{ form_errors(profileForm.telephone) }}
                        </div>
                    </div>

                    <hr class="my-5">

                    <!-- PASSWORD SECTION -->
                    <h5 class="fw-bold text-primary mb-4">
                        <i class="bi bi-shield-lock me-2"></i>
                        Modifier le mot de passe
                    </h5>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Nouveau mot de passe
                        </label>
                        {{ form_widget(profileForm.plainPassword.first, {
                            'attr': {'class': 'form-control'}
                        }) }}
                        <div class="text-danger small">
                            {{ form_errors(profileForm.plainPassword.first) }}
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Confirmer le mot de passe
                        </label>
                        {{ form_widget(profileForm.plainPassword.second, {
                            'attr': {'class': 'form-control'}
                        }) }}
                        <div class="text-danger small">
                            {{ form_errors(profileForm.plainPassword.second) }}
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button class="btn btn-primary px-5 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-check-circle me-2"></i>
                            Enregistrer les modifications
                        </button>
                    </div>

                    {{ form_end(profileForm) }}

                </div>
            </div>

        </div>
    </div>

</div>
{% endblock %}
