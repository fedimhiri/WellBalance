{% extends 'backend/baseend.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4">

    <h3 class="mb-4 fw-bold">Gestion des utilisateurs</h3>

    <div class="mb-4">
        <a href="{{ path('admin_document_index') }}" class="btn btn-primary">
            <i class="bx bx-file me-1"></i> Documents
        </a>
        <a href="{{ path('admin_document_stats') }}" class="btn btn-outline-primary ms-2">
            <i class="bx bx-bar-chart-alt-2 me-1"></i> Statistiques
        </a>
        <a href="{{ path('admin_categorie_index') }}" class="btn btn-outline-secondary ms-2">
            <i class="bx bx-folder me-1"></i> Catégories
        </a>
    </div>

    {# ============================
       🔢 STATISTIQUES PRINCIPALES
    ============================ #}
    <div class="row mb-4 g-3">

        <div class="col-md-2">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total</h6>
                    <h3 class="fw-bold">{{ stats.total }}</h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card text-center shadow-sm border-0 bg-danger text-white">
                <div class="card-body">
                    <h6>Admins</h6>
                    <h3 class="fw-bold">{{ stats.admin }}</h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card text-center shadow-sm border-0 bg-primary text-white">
                <div class="card-body">
                    <h6>Médecins</h6>
                    <h3 class="fw-bold">{{ stats.medecin }}</h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card text-center shadow-sm border-0 bg-success text-white">
                <div class="card-body">
                    <h6>Nutritionnistes</h6>
                    <h3 class="fw-bold">{{ stats.nutritionniste }}</h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card text-center shadow-sm border-0 bg-warning text-dark">
                <div class="card-body">
                    <h6>Coach</h6>
                    <h3 class="fw-bold">{{ stats.coach }}</h3>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card text-center shadow-sm border-0 bg-info text-dark">
                <div class="card-body">
                    <h6>Patients</h6>
                    <h3 class="fw-bold">{{ stats.patient }}</h3>
                </div>
            </div>
        </div>

    </div>

    {# ============================
       📊 ANALYSE VISUELLE
    ============================ #}
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">Répartition des rôles</h5>

            {% set total = stats.total > 0 ? stats.total : 1 %}

            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <span>Admins</span>
                    <span>{{ ((stats.admin / total) * 100)|round(1) }}%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar bg-danger"
                         style="width: {{ (stats.admin / total) * 100 }}%"></div>
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <span>Médecins</span>
                    <span>{{ ((stats.medecin / total) * 100)|round(1) }}%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar bg-primary"
                         style="width: {{ (stats.medecin / total) * 100 }}%"></div>
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <span>Nutritionnistes</span>
                    <span>{{ ((stats.nutritionniste / total) * 100)|round(1) }}%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar bg-success"
                         style="width: {{ (stats.nutritionniste / total) * 100 }}%"></div>
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <span>Coach</span>
                    <span>{{ ((stats.coach / total) * 100)|round(1) }}%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar bg-warning"
                         style="width: {{ (stats.coach / total) * 100 }}%"></div>
                </div>
            </div>

            <div>
                <div class="d-flex justify-content-between">
                    <span>Patients</span>
                    <span>{{ ((stats.patient / total) * 100)|round(1) }}%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar bg-info"
                         style="width: {{ (stats.patient / total) * 100 }}%"></div>
                </div>
            </div>

        </div>
    </div>

    {# ============================
       🔎 RECHERCHE + TRI
    ============================ #}
    <div class="row g-2 mb-3">

        <div class="col-md-6">
            <input type="text"
                   id="search-input"
                   class="form-control"
                   placeholder="Rechercher par email, username ou téléphone">
        </div>

        <div class="col-md-3">
            <select id="sort-select" class="form-select">
                <option value="">Trier par défaut</option>
                <option value="email">Email</option>
                <option value="username">Username</option>
                <option value="id">ID</option>
            </select>
        </div>

        <div class="col-md-3">
            <button id="reset-btn"
                    class="btn btn-outline-secondary w-100">
                Réinitialiser
            </button>
        </div>

    </div>  
   


    {# ============================
       TABLE DYNAMIQUE
    ============================ #}
    <div class="card shadow-sm">
    <div class="card-body">

        <div class="table-responsive mb-3" id="users-table">
            {% include 'backend/admin/_users_table.html.twig' %}
        </div>

        <!-- Bouton export PDF -->
        <div class="text-end">
            <a href="{{ path('admin_export_pdf') }}" class="btn btn-danger">
                <i class="bi bi-file-earmark-pdf"></i> Exporter en PDF
            </a>
        </div>

    </div>
</div>


</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}

<script>
document.addEventListener('DOMContentLoaded', function () {

    const searchInput = document.getElementById('search-input');
    const sortSelect = document.getElementById('sort-select');
    const resetBtn = document.getElementById('reset-btn');
    const tableContainer = document.getElementById('users-table');

    function fetchUsers() {

        const search = searchInput.value;
        const sort = sortSelect.value;

        fetch(`{{ path('admin_dashboard') }}?search=${search}&sort=${sort}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.text())
        .then(html => {
            tableContainer.innerHTML = html;
        });
    }

    searchInput.addEventListener('keyup', fetchUsers);
    sortSelect.addEventListener('change', fetchUsers);

    resetBtn.addEventListener('click', function () {
        searchInput.value = '';
        sortSelect.value = '';
        fetchUsers();
    });

});
</script>

{% endblock %}
