{% extends 'backend/baseend.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="container-fluid mt-4">

    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">

                    <div class="text-center mb-4">
                        <div class="avatar avatar-xl mb-3">
                            <img src="{{ asset('assets_backend/img/avatars/1.png') }}"
                                 class="rounded-circle shadow"
                                 width="90">
                        </div>

                        <h4 class="fw-bold">Mon Profil</h4>
                        <p class="text-muted small">
                            Gérez vos informations personnelles et votre sécurité
                        </p>
                    </div>

                    {{ form_start(profileForm) }}

                    <!-- EMAIL -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Adresse email</label>
                        {{ form_widget(profileForm.email, {
                            'attr': {'class': 'form-control bg-light'}
                        }) }}
                    </div>

                    <!-- USERNAME -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Nom d'utilisateur</label>
                        {{ form_widget(profileForm.username, {
                            'attr': {'class': 'form-control'}
                        }) }}
                        <div class="text-danger small">
                            {{ form_errors(profileForm.username) }}
                        </div>
                    </div>

                    <!-- TELEPHONE -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Téléphone</label>
                        {{ form_widget(profileForm.telephone, {
                            'attr': {'class': 'form-control'}
                        }) }}
                        <div class="text-danger small">
                            {{ form_errors(profileForm.telephone) }}
                        </div>
                    </div>

                    <hr class="my-5">

                    <!-- PASSWORD SECTION -->
                    <h5 class="fw-bold text-primary mb-4">
                        <i class="bx bx-lock-alt me-2"></i>
                        Modifier le mot de passe
                    </h5>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Nouveau mot de passe
                        </label>
                        {{ form_widget(profileForm.plainPassword.first, {
                            'attr': {'class': 'form-control'}
                        }) }}
                        <div class="text-danger small">
                            {{ form_errors(profileForm.plainPassword.first) }}
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Confirmer le mot de passe
                        </label>
                        {{ form_widget(profileForm.plainPassword.second, {
                            'attr': {'class': 'form-control'}
                        }) }}
                        <div class="text-danger small">
                            {{ form_errors(profileForm.plainPassword.second) }}
                        </div>
                    </div>

                    <!-- BUTTON -->
                    <div class="text-center mt-4">
                        <button class="btn btn-primary px-5 py-2 rounded-pill shadow-sm">
                            <i class="bx bx-save me-2"></i>
                            Enregistrer les modifications
                        </button>
                    </div>

                    {{ form_end(profileForm) }}

                </div>
            </div>

        </div>
    </div>

</div>
{% endblock %}
