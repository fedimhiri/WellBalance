<table class="table table-hover table-bordered align-middle">
    <thead class="table-dark text-center">
        <tr>
            <th>#</th>
            <th>Email</th>
            <th>Username</th>
            <th>Téléphone</th>
            <th>Rôle(s)</th>
            <th>Statut</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>

    <tbody>
    {% for user in users %}
        <tr>
            <td class="text-center">{{ user.id }}</td>

            <td>{{ user.email }}</td>

            <td><strong>{{ user.username }}</strong></td>

            <td>{{ user.telephone }}</td>

            <td class="text-center">
                {% for role in user.roles %}

                    {% if role == 'ROLE_ADMIN' %}
                        <span class="badge bg-danger">Admin</span>

                    {% elseif role == 'ROLE_USER' %}
                        <span class="badge bg-secondary">User</span>

                    {% elseif role == 'ROLE_MEDECIN' %}
                        <span class="badge bg-primary">Médecin</span>

                    {% elseif role == 'ROLE_NUTRITIONNISTE' %}
                        <span class="badge bg-success">Nutritionniste</span>

                    {% elseif role == 'ROLE_COACHSPORTIF' %}
                        <span class="badge bg-warning text-dark">Coach</span>

                    {% elseif role == 'ROLE_PATIENT' %}
                        <span class="badge bg-info text-dark">Patient</span>

                    {% endif %}

                {% endfor %}
            </td>

            {# 🔥 STATUT BAN #}
            <td class="text-center">
                {% if user.isBanned %}
                    <span class="badge bg-danger">Banni</span>
                {% else %}
                    <span class="badge bg-success">Actif</span>
                {% endif %}
            </td>

            <td class="text-end">

                <div class="d-flex justify-content-end gap-2">

                    <a href="{{ path('admin_user_edit', {id: user.id}) }}"
                       class="btn btn-sm btn-outline-primary">
                        Modifier
                    </a>

                    {# 🔥 BOUTON BAN / UNBAN #}
                    <form method="post"
                          action="{{ path('admin_user_ban', {id: user.id}) }}">

                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('ban' ~ user.id) }}">

                        {% if user.isBanned %}
                            <button type="submit"
                                    class="btn btn-sm btn-outline-success">
                                Débannir
                            </button>
                        {% else %}
                            <button type="submit"
                                    class="btn btn-sm btn-outline-warning">
                                Bannir
                            </button>
                        {% endif %}
                    </form>

                    <form method="post"
                          action="{{ path('admin_user_delete', {id: user.id}) }}"
                          onsubmit="return confirm('Confirmer la suppression ?');">

                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('delete' ~ user.id) }}">

                        <button type="submit"
                                class="btn btn-sm btn-outline-danger">
                            Supprimer
                        </button>
                    </form>

                </div>

            </td>
        </tr>

    {% else %}
        <tr>
            <td colspan="7" class="text-center text-muted py-4">
                Aucun utilisateur trouvé
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
